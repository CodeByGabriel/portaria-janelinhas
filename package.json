{
  "name": "portaria-janelinhas",
  "private": true,
  "version": "0.1.0",
  "description": "App de saida de alunos da escola Janelinhas do Saber. Vitrine.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "npm run test:puro && npm run test:worker",
    "typecheck": "wrangler types && tsc --noEmit",
    "tipos": "wrangler types",
    "demo:offline": "node ferramentas/construir-demo.mjs",
    "fim-a-fim": "node ferramentas/fim-a-fim.mjs",
    "test:puro": "node --experimental-strip-types --test \"src/*.test.ts\"",
    "test:worker": "vitest run",
    "telas": "node ferramentas/telas.mjs",
    "peso": "node ferramentas/peso.mjs",
    "fontes": "node ferramentas/subsetar-fontes.mjs",
    "responsivo": "node ferramentas/responsivo.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.3",
    "@types/node": "^26.4.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
